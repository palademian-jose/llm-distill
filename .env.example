# ---- Provider selection -------------------------------------------------
# fake | openrouter | anthropic | openai
# Leave empty for auto: openrouter when OPENROUTER_API_KEY is set, else
# anthropic/openai when their key is set, else fake (with a one-line warning).
LLM_PROVIDER=
# Model ids are OpenRouter slugs; the anthropic/openai direct backends strip the
# vendor prefix automatically. CHEAP_MODEL is the teacher.
LLM_MODEL=anthropic/claude-sonnet-5.5
JUDGE_MODEL=openai/gpt-5.4-mini
CHEAP_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=llm-distill
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Data -----------------------------------------------------------------
SNAPSHOT_DIR=data/docs-rag-snapshot
PAIRS_PATH=data/pairs.jsonl
TEACHER_LABELS_PATH=data/teacher_labels.jsonl
CHUNK_SIZE=128
CHUNK_OVERLAP=16

# ---- Students -------------------------------------------------------------
STUDENT_BASE_MODEL=sentence-transformers/all-MiniLM-L6-v2
STUDENT_DIR=models/s1-minilm
ONNX_PATH=models/s1-minilm/model.onnx
TFIDF_PATH=models/s2-tfidf.joblib
# torch | onnx | tfidf (backend used by StudentClient)
STUDENT_BACKEND=onnx
STUDENT_THRESHOLD=0.5

# ---- Cost model -----------------------------------------------------------
# Students are priced from measured CPU time at this hourly rate (USD).
CPU_USD_PER_HOUR=0.10
PRICING_PATH=pricing.json
